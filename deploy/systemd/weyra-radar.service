[Unit]
Description=Weyra OPERA radar maintenance worker
After=network-online.target local-fs.target
Wants=network-online.target
ConditionPathExists=/srv/apps/weyra/current/dist/radar-worker.mjs

[Service]
Type=simple
User=weyra
Group=weyra
WorkingDirectory=/srv/apps/weyra/current
EnvironmentFile=/etc/weyra/weyra.env
EnvironmentFile=-/etc/weyra/release.env
ExecStart=/usr/local/bin/node dist/radar-worker.mjs
Restart=on-failure
RestartSec=20s
TimeoutStopSec=45s
KillMode=control-group
UMask=0027

Nice=10
IOSchedulingClass=idle
CPUQuota=80%
MemoryHigh=700M
MemoryMax=900M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/apps/weyra/shared/radar-cache

[Install]
WantedBy=multi-user.target
