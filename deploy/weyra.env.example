NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3100
NEXT_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=384

WEYRA_RELEASE_SHA=
WEYRA_RADAR_CACHE_DIR=/srv/apps/weyra/shared/radar-cache
WEYRA_RADAR_MAINTENANCE_MODE=external
WEYRA_RADAR_MAINTENANCE_TOKEN=
WEYRA_RADAR_POLL_SECONDS=90
WEYRA_RADAR_MAX_PACKS=16
WEYRA_RADAR_MAX_CONCURRENT_RENDERS=1
WEYRA_RADAR_MAX_CONCURRENT_TILE_RENDERS=1
WEYRA_RADAR_MAX_CONCURRENT_PACK_BUILDS=1
WEYRA_RADAR_DEGRADED_AGE_SECONDS=900
WEYRA_RADAR_CRITICAL_AGE_SECONDS=1800
WEYRA_RADAR_DEGRADED_LAG_SECONDS=600
WEYRA_RADAR_CRITICAL_LAG_SECONDS=1200
WEYRA_RADAR_WORKER_HEARTBEAT_GRACE_SECONDS=300
WEYRA_RADAR_ALERT_WEBHOOK_URL=
WEYRA_RADAR_ALERT_WEBHOOK_TOKEN=
PYTHON_BIN=/srv/apps/weyra/current/.venv/bin/python
METEOFRANCE_BUFR_DECODER=/srv/apps/weyra/current/radar-worker/bin/decode_meteofrance_bufr
METEOFRANCE_BUFR_TABLES_DIR=/srv/apps/weyra/current/radar-worker/vendor/opera-bufr-3.2/tables

METEOGATE_API_KEY=
METEOFRANCE_APPLICATION_ID=
METEOFRANCE_ACCESS_TOKEN=

# Reserved for the self-hosted Weyra PostgreSQL/auth/media platform.
WEYRA_DATABASE_URL=
WEYRA_SESSION_SECRET=
WEYRA_MEDIA_ROOT=/srv/apps/weyra/shared/media
