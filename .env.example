# Optional: leave blank to use browser-local observations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never expose this key in NEXT_PUBLIC_*, browser code, logs, or API responses.
SUPABASE_SECRET_KEY=

# Radar gateway — SERVER ONLY. Never put a Météo-France credential in NEXT_PUBLIC_*.
# 1) During development, keep empty: /api/radar/timeline uses the RainViewer 10-minute fallback.
# 2) For the France 5-minute production path, point this at a Weyra server/worker that
#    reads the authorised Météo-France radar endpoint, caches/transforms frames to tiles,
#    and returns: { host, radar:{past:[{time,path}]}, provider:'meteofrance', cadenceMinutes:5 }.
WEYRA_RADAR_TIMELINE_URL=
WEYRA_RADAR_ADAPTER_TOKEN=

# EUMETNET OPERA / MeteoGate - SERVER ONLY.
METEOGATE_API_KEY=

# Optional local/production radar runtime settings.
# Keep the production cache outside release directories.
WEYRA_RADAR_CACHE_DIR=
PYTHON_BIN=
WEYRA_RADAR_MAINTENANCE_MODE=
WEYRA_RADAR_MAINTENANCE_TOKEN=
WEYRA_RADAR_POLL_SECONDS=90
WEYRA_RADAR_MAX_PACKS=16
WEYRA_RADAR_MAX_CONCURRENT_RENDERS=2
WEYRA_RADAR_MAX_CONCURRENT_TILE_RENDERS=2
WEYRA_RADAR_MAX_CONCURRENT_PACK_BUILDS=2

# Safe release identifier shown by /api/health.
WEYRA_RELEASE_SHA=
