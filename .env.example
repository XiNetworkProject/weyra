# Future self-hosted Weyra data platform. These values are server-only.
# The current local prototype remains usable while the PostgreSQL repositories are implemented.
WEYRA_DATABASE_URL=
WEYRA_SESSION_SECRET=
WEYRA_MEDIA_ROOT=

# EUMETNET OPERA / MeteoGate - SERVER ONLY.
METEOGATE_API_KEY=

# Météo-France Package Radar - SERVER ONLY.
# Prefer APPLICATION_ID: the server renews its hourly OAuth token automatically.
# ACCESS_TOKEN is only a temporary local fallback and must never be committed or exposed to the browser.
METEOFRANCE_APPLICATION_ID=
METEOFRANCE_ACCESS_TOKEN=
METEOFRANCE_BUFR_DECODER=
METEOFRANCE_BUFR_TABLES_DIR=

# Optional local/production radar runtime settings.
# Keep the production cache outside release directories.
WEYRA_RADAR_CACHE_DIR=
PYTHON_BIN=
WEYRA_RADAR_MAINTENANCE_MODE=
WEYRA_RADAR_MAINTENANCE_TOKEN=
WEYRA_RADAR_POLL_SECONDS=90
WEYRA_RADAR_MAX_PACKS=16
WEYRA_RADAR_MAX_CONCURRENT_RENDERS=2
WEYRA_RADAR_MAX_CONCURRENT_TILE_RENDERS=2
WEYRA_RADAR_MAX_CONCURRENT_PACK_BUILDS=2
WEYRA_RADAR_DEGRADED_AGE_SECONDS=900
WEYRA_RADAR_CRITICAL_AGE_SECONDS=1800
WEYRA_RADAR_DEGRADED_LAG_SECONDS=600
WEYRA_RADAR_CRITICAL_LAG_SECONDS=1200
WEYRA_RADAR_WORKER_HEARTBEAT_GRACE_SECONDS=300

# Optional operational webhook. Server/worker only; never expose it to the browser.
WEYRA_RADAR_ALERT_WEBHOOK_URL=
WEYRA_RADAR_ALERT_WEBHOOK_TOKEN=

# Safe release identifier shown by /api/health.
WEYRA_RELEASE_SHA=
